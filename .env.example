# Backend API base URL (exposed to the browser via Vite)
VITE_API_URL=https://hari.cavaluer.com

# Supabase (client-safe publishable key only — use VITE_ prefix)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: server-only Supabase vars (no VITE_ prefix) for SSR
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=